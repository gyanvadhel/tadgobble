{
  "name": "tadgobble",
  "version": "0.1.0",
  "private": true,
  "description": "A playful community for art, design, and useful apps, with image-first sharing, saved finds, and human-reviewed listings.",
  "repository": {
    "type": "git",
    "url": "https://github.com/gyanvadhel/tadgobble.git"
  },
  "homepage": "https://tadgobble.web.app",
  "bugs": {
    "url": "https://github.com/gyanvadhel/tadgobble/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "worker": "node --env-file-if-exists=.env.local scripts/worker.mjs",
    "setup": "node scripts/setup.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:launch": "node scripts/launch-e2e.mjs",
    "test:submission": "node scripts/submission-e2e.mjs",
    "test:covers": "node scripts/covers-e2e.mjs",
    "build:hosting": "node scripts/build-hosting.mjs",
    "deploy:hosting": "npm run build:hosting && firebase deploy --only hosting --project tadgobble",
    "worker:cloud": "node --env-file-if-exists=.env.local scripts/cloud-worker.mjs",
    "sync:cloud": "node --env-file-if-exists=.env.local scripts/sync-cloud.mjs",
    "test:cloud": "node --test tests/cloud.test.mjs",
    "preview:hosting": "node scripts/serve-hosting.mjs",
    "test:cloud:e2e": "node --env-file-if-exists=.env.local scripts/cloud-e2e.mjs",
    "test:cloud:artwork": "node --env-file-if-exists=.env.local scripts/cloud-artwork-e2e.mjs",
    "test:cloud:auth": "node scripts/cloud-auth-e2e.mjs",
    "test:creators": "node scripts/creators-e2e.mjs",
    "test:videos": "node scripts/videos-e2e.mjs",
    "test:cloud:videos": "node --env-file-if-exists=.env.local scripts/cloud-video-e2e.mjs",
    "test:onboarding": "node scripts/onboarding-e2e.mjs",
    "test:cloud:onboarding": "node --env-file-if-exists=.env.local scripts/cloud-onboarding-e2e.mjs"
  },
  "dependencies": {
    "@blobatar/react": "2.7.0",
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.118.0",
    "blobatar": "2.7.0",
    "ffmpeg-static": "5.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "1.60.0",
    "mediabunny": "^1.62.0",
    "next": "16.4.2",
    "playwright": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "firebase-tools": "^15.34.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0"
  }
}
