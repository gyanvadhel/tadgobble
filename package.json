{
  "name": "tadgobble",
  "version": "0.1.0",
  "private": true,
  "description": "A playful product-discovery community with website previews, maker submissions, saved finds, and human-reviewed listings.",
  "repository": {
    "type": "git",
    "url": "https://github.com/gyanvadhel/tadgobble.git"
  },
  "homepage": "https://github.com/gyanvadhel/tadgobble#readme",
  "bugs": {
    "url": "https://github.com/gyanvadhel/tadgobble/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "worker": "node --env-file-if-exists=.env.local scripts/worker.mjs",
    "setup": "node scripts/setup.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:launch": "node scripts/launch-e2e.mjs",
    "test:submission": "node scripts/submission-e2e.mjs",
    "test:covers": "node scripts/covers-e2e.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "ffmpeg-static": "5.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "playwright": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
