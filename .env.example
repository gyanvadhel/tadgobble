APP_URL=http://127.0.0.1:3000
ADMIN_EMAIL=owner@example.com
# Generate a strong password with npm run setup. Never commit this file's local copy.
ADMIN_PASSWORD=
DATA_DIR=./data
# Cloud build: these two values are public and are included in browser JavaScript.
NEXT_PUBLIC_SUPABASE_URL=https://ixyfcswubxncobcnjget.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
CLOUD_APP_URL=https://tadgobble.web.app
# Optional cloud worker login override; falls back to ADMIN_EMAIL/ADMIN_PASSWORD.
CLOUD_ADMIN_EMAIL=
CLOUD_ADMIN_PASSWORD=
# Configure Google OAuth credentials in Supabase's dashboard, never in NEXT_PUBLIC_* variables.
# Optional demo fixtures. Real installations start with an empty catalog.
SEED_CATALOG=false
# Publishing only runs when both the connection and this switch are configured.
INSTAGRAM_PUBLISH_ENABLED=false
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=
# Public HTTPS origin serving this app's /media files. Required for Instagram.
PUBLIC_MEDIA_ORIGIN=
# 0 disables the app's daily scheduling/publishing cap.
DAILY_POST_LIMIT=0
# Optional absolute ffmpeg executable; otherwise the bundled binary is used.
FFMPEG_PATH=
